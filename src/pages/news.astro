---
import Base from "../layouts/Base.astro";
import NewsList from "../components/NewsList.astro";
import { loadYaml, type NewsItem } from "../lib/data";
const news = loadYaml<NewsItem[]>("news.yml");
---

<Base progress title="News" description="News and announcements from Zae Myung Kim.">
  <header class="page-head">
    <div class="eyebrow">{news.length} items</div>
    <h1>News</h1>
  </header>
  <NewsList items={news} full />
</Base>
