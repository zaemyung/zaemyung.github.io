---
import PillarArt from "./PillarArt.astro";
import { loadYaml, allPapers, findPaper, type Profile } from "../lib/data";
const p = loadYaml<Profile>("profile.yml");
const papers = allPapers();
const topicOf: Record<string, string> = {
  Structure: "structure",
  Metacognition: "metacognition",
  Collaboration: "collaboration",
  Multilingual: "multilingual",
};
// The hero's .rise cascade uses indexes 0 … 3 + lead paragraphs (name, role, thesis, leads, buttons).
const base = 4 + p.lead.length;
---

<section class="pillars">
  <h2 class="rise" style={`--i:${base}`}>Current research <em>focus</em></h2>
  <div class="pillar-grid">
    {
      p.pillars.map((pl, idx) => {
        const t = topicOf[pl.tag] ?? "others";
        return (
          <article
            class="pillar rise"
            data-topic={t}
            data-tilt
            style={`--pillar-color: var(--tc); --i:${base + 1 + idx}`}
          >
            <div class="pillar-top">
              <span class="pillar-num">{pl.num}</span>
              <span class="pillar-tag">{pl.tag}</span>
            </div>
            <PillarArt kind={pl.art} />
            <h3>{pl.heading}</h3>
            <p>{pl.blurb}</p>
            <div class="chips">
              {pl.papers.map((c) => {
                const paper = findPaper(papers, c.match);
                const href = paper ? `/gallery/#${paper.id}` : "/publications/";
                return (
                  <a class="chip" href={href} title={paper?.title ?? c.label}>
                    {c.label}
                  </a>
                );
              })}
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import "../scripts/pillars";
</script>
