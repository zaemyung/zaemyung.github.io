---
import { loadYaml, type NavItem, type Profile } from "../lib/data";
import Icon from "./Icon.astro";

const nav = loadYaml<NavItem[]>("nav.yml");
const profile = loadYaml<Profile>("profile.yml");
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
function isCurrent(href: string) {
  const h = href.replace(/\/+$/, "") || "/";
  return h === "/" ? path === "/" : path === h || path.startsWith(h + "/");
}
---

<header class="site-nav" id="site-nav">
  <div class="container">
    <a class="brand" href="/">{profile.name}</a>
    <button class="icon-btn nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
      <Icon name="menu" />
    </button>
    <ul class="nav-links" id="nav-links">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[{ ext: item.external }]}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener" : undefined}
              aria-current={!item.external && isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="nav-ind" role="presentation" aria-hidden="true"></li>
    </ul>
    <button class="icon-btn theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
      <!-- One glyph for both themes: the disc grows and a masked bite carves the crescent; the rays fold away. -->
      <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true">
        <mask id="theme-mask">
          <rect width="24" height="24" fill="#fff"></rect>
          <circle class="bite" cx="16" cy="8" r="6.5" fill="#000"></circle>
        </mask>
        <circle class="disc" cx="12" cy="12" r="5" mask="url(#theme-mask)"></circle>
        <g class="rays" fill="none" stroke-width="1.7" stroke-linecap="round">
          <line x1="12" y1="2.2" x2="12" y2="4.2"></line>
          <line x1="12" y1="19.8" x2="12" y2="21.8"></line>
          <line x1="2.2" y1="12" x2="4.2" y2="12"></line>
          <line x1="19.8" y1="12" x2="21.8" y2="12"></line>
          <line x1="5.1" y1="5.1" x2="6.5" y2="6.5"></line>
          <line x1="17.5" y1="17.5" x2="18.9" y2="18.9"></line>
          <line x1="5.1" y1="18.9" x2="6.5" y2="17.5"></line>
          <line x1="17.5" y1="6.5" x2="18.9" y2="5.1"></line>
        </g>
      </svg>
    </button>
  </div>
</header>

<script>
  import "../scripts/nav";
</script>
