---
import Icon from "./Icon.astro";
import NewsList from "./NewsList.astro";
import { loadYaml, formatYm, type Profile, type NewsItem } from "../lib/data";

const profile = loadYaml<Profile>("profile.yml");
const news = loadYaml<NewsItem[]>("news.yml");
interface Exp {
  role: string;
  org: string;
  location: string;
  start: string;
  end: string | null;
  tz?: string;
}
interface Edu {
  degree: string;
  school: string;
  start: string;
  end: string;
  expected: boolean;
}
const exp = loadYaml<Exp[]>("experience.yml");
const edu = loadYaml<Edu[]>("education.yml");
const today = new Date().toISOString().slice(0, 7);
const isCurrent = (start: string, end: string | null) => start <= today && (!end || end >= today);
const currentExp = exp.filter((e) => isCurrent(e.start, e.end));
const now = [
  ...edu
    .filter((d) => d.expected || isCurrent(d.start, d.end))
    .map((d) => ({
      role: "Ph.D. candidate",
      where: d.school.replace(/\s*Twin Cities$/, ""),
      when: `${formatYm(d.start)} – ${formatYm(d.end)}${d.expected ? " (expected)" : ""}`,
      start: d.start,
    })),
  ...currentExp.map((e) => ({
    role: e.role,
    where: `${e.org}, ${e.location}`,
    when: `${formatYm(e.start)} – ${formatYm(e.end)}`,
    start: e.start,
  })),
];
// The most recently started position gets the live (pulsing) dot.
const latest = now.reduce((m, n) => (n.start > m ? n.start : m), "");
// Live clocks: home first, then any current position in another time zone.
const city = (s: string) => s.split(",")[0]!.trim();
const clocks = new Map<string, string>();
if (profile.tz) clocks.set(profile.tz, profile.clock_label ?? city(profile.location));
for (const e of currentExp) if (e.tz && !clocks.has(e.tz)) clocks.set(e.tz, city(e.location));
---

<aside class="sidebar">
  <div class="identity rise" style="--i:0">
    <a class="portrait" href="/gallery/" title="Research gallery" aria-label="Open the research gallery">
      <img class="photo" src={profile.photo} alt={profile.name} width="168" height="168" />
    </a>
    <h2>{profile.name}</h2>
    {profile.name_native && <div class="native">{profile.name_native}</div>}
    <div class="lines">
      <div>{profile.title}</div>
      <div>{profile.department}</div>
      <div><a href="https://twin-cities.umn.edu/">{profile.affiliation}</a></div>
      <div>{profile.location}</div>
    </div>
    <ul class="socials">
      {
        profile.socials.map((s) => (
          <li>
            <a
              href={s.href}
              title={s.label}
              aria-label={s.label}
              target={s.href.startsWith("mailto:") ? undefined : "_blank"}
              rel="noopener"
            >
              <Icon name={s.icon} size={17} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {
    now.length > 0 && (
      <div class="side-block rise" style="--i:1">
        <div class="label">Now</div>
        <ul class="now">
          {now.map((n) => (
            <li title={`${n.role} at ${n.where}`}>
              <span class:list={["dot", { live: n.start === latest }]} aria-hidden="true" />
              <div>
                <b>{n.role}</b> at {n.where}
                <span class="when">{n.when}</span>
              </div>
            </li>
          ))}
        </ul>
        {clocks.size > 0 && (
          <div class="clocks" hidden>
            {[...clocks].map(([tz, label]) => (
              <span>
                {label}
                <time data-tz={tz} />
              </span>
            ))}
          </div>
        )}
      </div>
    )
  }

  <div class="side-block rise" style="--i:2">
    <div class="label">Affiliations</div>
    <div class="pills">
      {
        profile.affiliations.map((a) =>
          a.href ? (
            <a class="chip" href={a.href} target="_blank" rel="noopener">
              {a.label}
            </a>
          ) : (
            <span class="chip">{a.label}</span>
          ),
        )
      }
    </div>
  </div>

  <div class="side-block rise" style="--i:3">
    <div class="label">
      News <a class="more" href="/news/">all <span class="arr">→</span></a>
    </div>
    <NewsList items={news} limit={3} />
  </div>
</aside>

<script>
  import "../scripts/sidebar";
</script>
